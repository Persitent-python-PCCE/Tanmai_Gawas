pipeline {

    agent any

    environment {
        DOCKER_HOST = 'tcp://localhost:2375'

        FLASK_ENV = 'testing'

        SECRET_KEY = 'jenkins-test-secret-key'
        JWT_SECRET_KEY = 'jenkins-test-jwt-secret-key'

        TEST_DATABASE_URI = 'sqlite:///test.db'

        EMAIL='sunitagawas580@gmail.com'
        APP_PASSWORD='thbpduiejsshwuqi'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Login Test') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'dockerhub-credentials',
                usernameVariable: 'DOCKER_USER',
                passwordVariable: 'DOCKER_PASS'
            )
        ]) {
            bat '''
                echo DOCKER_USER is [%DOCKER_USER%]
                powershell -Command "Write-Host ('DOCKER_PASS length: ' + $env:DOCKER_PASS)"
                echo %DOCKER_PASS% | docker -H tcp://localhost:2375 login -u %DOCKER_USER% --password-stdin
                if errorlevel 1 exit /b 1
                docker info
                docker logout
            '''
        }
    }
}

        stage('Install Dependencies') {
            steps {
                bat '"C:\\Users\\hp\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe" -m pip install -r Devops-proj\\requirements.txt'
            }
        }

        stage('Test') {
            steps {
                bat '''
                    cd Devops-proj
                    "C:\\Users\\hp\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe" -m pytest -v
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Devops-proj') {
                    bat 'docker build -t tanmaigawas/flask-app:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    bat '''
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                        docker push tanmaigawas/flask-app:latest
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}