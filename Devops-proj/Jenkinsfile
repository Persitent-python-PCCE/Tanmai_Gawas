pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        // From Script 2: Docker & App Configurations
        DOCKER_HOST        = 'tcp://localhost:2375'
        FLASK_ENV          = 'testing'
        SECRET_KEY         = 'jenkins-test-secret-key'
        JWT_SECRET_KEY     = 'jenkins-test-jwt-secret-key'
        TEST_DATABASE_URI  = 'sqlite:///test.db'
        EMAIL              = 'sunitagawas580@gmail.com'
        APP_PASSWORD       = 'thbpduiejsshwuqi'
        
        // Unified Executable Paths (Easily modify these variables if needed)
        PYTHON_PATH_1      = 'C:\\Users\\ArulanandhaGuru\\AppData\\Local\\Programs\\Python\\Python311\\python.exe'
        PYTHON_PATH_2      = 'C:\\Users\\hp\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies & Test') {
            steps {
                // Runs tasks for User 1 (Root Directory)
                bat """
                    "${env.PYTHON_PATH_1}" --version
                    "${env.PYTHON_PATH_1}" -m pip install -r requirements.txt
                    "${env.PYTHON_PATH_1}" -m pytest
                """
                // Runs tasks for User 2 (Devops-proj Subdirectory)
                bat """
                    "${env.PYTHON_PATH_2}" -m pip install -r Devops-proj\\requirements.txt
                    cd Devops-proj
                    "${env.PYTHON_PATH_2}" -m pytest -v
                """
            }
        }

        stage('Build Docker Images') {
            steps {
                // Build User 1 Image (Root Directory)
                bat 'docker build -t arulguru03/flask-app:latest .'
                
                // Build User 2 Image (Devops-proj Subdirectory)
                dir('Devops-proj') {
                    bat 'docker build -t tanmaigawas/flask-app:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                // Authenticate and push for User 1
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-cred',
                        usernameVariable: 'DOCKER_USER_1',
                        passwordVariable: 'DOCKER_PASS_1'
                    )
                ]) {
                    bat '''
                        docker login -u %DOCKER_USER_1% -p %DOCKER_PASS_1%
                        docker push arulguru03/flask-app:latest
                        docker logout
                    '''
                }

                // Authenticate and push for User 2 (Secure stdin format)
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER_2',
                        passwordVariable: 'DOCKER_PASS_2'
                    )
                ]) {
                    bat '''
                        echo %DOCKER_PASS_2% | docker login -u %DOCKER_USER_2% --password-stdin
                        docker push tanmaigawas/flask-app:latest
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            emailext(
                subject: "SUCCESS ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Jenkins build Successful</h2>
                    <p><b>URL</b>: ${env.BUILD_URL}</p>
                """,
                to: "arulanandha.guru@revature.com"
            )
        }

        failure {
            echo 'Pipeline failed!'
            emailext(
                subject: "FAILED ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h2>Jenkins build Failed</h2>
                    <p><b>URL</b>: ${env.BUILD_URL}</p>
                """,
                to: "gawastanmay373@gmail.com"
            )
        }
    }
}
